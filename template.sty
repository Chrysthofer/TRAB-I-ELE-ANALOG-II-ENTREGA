% PAGINA INICIAL
\newcommand{\maketitlepage}{
	\begin{titlepage}
		\centering
        \vfill
        % Imagem exclusiva da capa
       \includegraphics[width=0.5\textwidth]{\@logocapa}\\[1.5 cm]	
        \textsc{\LARGE \@competicao}\\[1.0 cm]
        \textsc{\LARGE \@instituicao}\\[1.0 cm]
        \vfill
	    \rule{\linewidth}{0.2 mm} \\[0.4 cm]
        { \LARGE \bfseries \@disciplina \\~\\
       \Large \@numeroEquipe {}\@equipe}\par
	    \rule{\linewidth}{0.2 mm} \\
        \vfill
        
        {\Large \@alunos}
       \vfill
        
        {\large \@email}\par
        \vfill
        
	    {\large \today} \\   
		\clearpage
	\end{titlepage}
}

